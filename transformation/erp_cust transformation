# Normalizing the id similar to the previously done customer_info table
CID_df['customer_id'] = CID_df['customer_id'].astype(str).str[-5:]

# Fixing the gender column to show either male, female, or not available
CID_df['gender'] = (
    CID_df['gender']
    .astype(str)
    .str.strip()
    .replace({'': np.nan})
    .str.upper()
    .replace({
        'F': 'Female',
        'M': 'Male',
        'FEMALE': 'Female',
        'MALE': 'Male'
    })
    .fillna('Not Available')
)

# Check the code
