def insert_table(df, table_name, columns):
    placeholders = ", ".join(["?"] * len(columns))
    insert_sql = f"INSERT INTO {table_name} ({', '.join(columns)}) VALUES ({placeholders})"
    
    for idx, row in df.iterrows():
        data = list(row[columns])
        # Ensure any remaining float NaN is converted to None
        data = [None if isinstance(x, float) and pd.isna(x) else x for x in data]
        try:
            cursor.execute(insert_sql, data)
        except Exception as e:
            print(f"Error inserting row {idx} into {table_name}")
            print("Row data:", data)
            print("Error:", e)
    
    conn.commit()
    print(f"Inserted {len(df)} rows into {table_name}")

