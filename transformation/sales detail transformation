# Fixing the sales and price accordingly
def fix_sales_row(row, tol=1e-9):
    sales = row['sls_sales']
    qty = row['quantity']
    price = row['price']

    # Step 1: enforce basic assumptions
    if pd.notna(price):
        price = abs(price)   # unit price should be positive

    if pd.notna(qty):
        qty = abs(qty)       # quantity should be positive

    # Step 2: fill missing price from sales and quantity
    if pd.isna(price) and pd.notna(sales) and pd.notna(qty) and qty != 0:
        price = abs(sales) / qty

    # Step 3: fill missing sales from quantity and price
    if pd.isna(sales) and pd.notna(qty) and pd.notna(price):
        sales = qty * price

    # Step 4: fix zero sales if quantity and price exist
    if pd.notna(sales) and sales == 0 and pd.notna(qty) and pd.notna(price):
        sales = qty * price

    # Step 5: if all 3 exist but are inconsistent, repair intelligently
    if pd.notna(sales) and pd.notna(qty) and pd.notna(price) and qty != 0 and price != 0:
        expected_abs_sales = qty * price

        if not np.isclose(abs(sales), expected_abs_sales, atol=tol):
            inferred_qty = abs(sales) / price
            inferred_price = abs(sales) / qty

            # If inferred quantity is basically an integer, prefer fixing quantity
            if np.isclose(inferred_qty, round(inferred_qty), atol=tol):
                qty = int(round(inferred_qty))
            else:
                price = inferred_price

        # Rebuild sales using corrected values, preserving original sign if sales existed
        sign = -1 if pd.notna(sales) and sales < 0 else 1
        sales = sign * qty * price

    # Final cleanup
    if pd.notna(qty):
        qty = int(round(qty))

    row['sls_sales'] = sales
    row['quantity'] = qty
    row['price'] = price
    return row

